# Gemini API key — used for direct question generation (no RAG server needed)
GEMINI_API_KEY=
# Use Docker/Postgres for a production-like local setup:
>>>>>>> 79e4e27 (Personal Workspace is created)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shikkhaai
# Or use SQLite for zero-setup local development (NOT for production — Render's
# filesystem is ephemeral):
# DATABASE_URL=sqlite:///./shikkhaai.db

# Standalone RAG service URL (rag_server.py). The /rag suffix matches
# app.include_router(rag_router, prefix="/rag"). On Render set this to the
# public RAG service URL, e.g. https://shikkhaai-rag.onrender.com/rag
RAG_BASE_URL=http://localhost:8100/rag

# Gemini generation is slow — keep this timeout high.
RAG_TIMEOUT_SECONDS=60

# Call the RAG module in-process instead of over HTTP. Only works in the
# monorepo dev setup where rag/ + its heavy deps are installed. Keep false for
# a standalone backend deploy so it uses RAG_BASE_URL over HTTP.
RAG_INPROCESS=false

# false = call the real RAG/Gemini path; true = built-in mock questions.
MOCK_MODE=false

# JWT signing secret — MUST be a strong random value in production.
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: comma-separated allowed origins, or * for any. Note: with *, browser
# credentialed requests are disabled. Set explicit origins in production.
CORS_ORIGINS=*

# Enable debug mode (verbose logging, slower but more info)
DEBUG=true
