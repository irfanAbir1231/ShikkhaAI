# Use Docker/Postgres for a production-like local setup:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shikkhaai
#
# Or use SQLite for zero-setup local development:
# DATABASE_URL=sqlite:///./shikkhaai.db
# Point at the standalone RAG service (rag_server.py). The /rag suffix
# matches app.include_router(rag_router, prefix="/rag").
RAG_BASE_URL=http://localhost:8100/rag
# Gemini generation takes longer than a normal API call — keep this high.
RAG_TIMEOUT_SECONDS=60
# false = call the real RAG service; true = built-in mock questions.
MOCK_MODE=false
CORS_ORIGINS=*
