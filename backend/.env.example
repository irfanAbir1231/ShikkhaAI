# Environment: development, production, testing
ENVIRONMENT=development

# ============================================================================
# DATABASE CONFIGURATION (Required)
# ============================================================================
# PostgreSQL is required for production deployment.
# For local development with SQLite:
#   DATABASE_URL=sqlite:///./shikkhaai.db
# For PostgreSQL (production):
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/shikkhaai
# For Render PostgreSQL:
#   DATABASE_URL=postgresql://...  (Render provides this automatically)
>>>>>>> Stashed changes
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/shikkhaai

# ============================================================================
# AI/EXAM GENERATION (At least one required for production)
# ============================================================================
# Gemini API Key - Get from https://ai.google.dev
# Used directly for exam generation without RAG context
GEMINI_API_KEY=your-gemini-api-key-here

# RAG Service URL - For AI-powered exam generation with context
# Example: http://localhost:8100/rag (local) or https://your-rag-service.com (production)
RAG_BASE_URL=http://localhost:8100/rag

# Request timeout for RAG service (in seconds)
RAG_TIMEOUT_SECONDS=60

# ============================================================================
# FRONTEND & SECURITY
# ============================================================================
# CORS Origins (comma-separated list)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://your-frontend.com,https://www.your-frontend.com
# DO NOT USE "*" in production!
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# TESTING & DEBUG
# ============================================================================
# Use mock exam data instead of real AI generation
MOCK_MODE=true

# Enable debug mode (verbose logging, slower but more info)
DEBUG=true

# ============================================================================
# RENDER DEPLOYMENT SPECIFIC
# ============================================================================
# On Render, set these environment variables:
# 1. ENVIRONMENT=production
# 2. DATABASE_URL=<your-postgres-db-url> (provided by Render)
# 3. GEMINI_API_KEY=<your-key>
# 4. CORS_ORIGINS=https://your-frontend-render-domain.onrender.com
# 5. MOCK_MODE=false
# 6. DEBUG=false
