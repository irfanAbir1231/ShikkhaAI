# Environment: development, production, testing
ENVIRONMENT=development

# Gemini API key(s) — used for direct question generation and grading.
# A single key, or a comma-separated pool of keys for quota rotation.
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Database. Render Postgres add-ons expose DATABASE_URL automatically; the
# backend rewrites the legacy `postgres://` scheme to SQLAlchemy's form.
