APP_NAME=ShikkhaAI Backend

# Use Render's managed PostgreSQL connection string in production.
# Local development can use: sqlite:///./shikkhaai.db
DATABASE_URL=sqlite:///./shikkhaai.db

# Standalone RAG service URL, including its /rag prefix.
RAG_BASE_URL=http://localhost:8100/rag
RAG_TIMEOUT_SECONDS=60
RAG_INPROCESS=false

# Set true only for local development without external services.
MOCK_MODE=true

# Comma-separated Gemini key pool. Never commit real keys.
GEMINI_API_KEY=

# Use explicit frontend origins in production.
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
